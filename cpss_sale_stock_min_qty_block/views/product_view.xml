<odoo>
    <record id="product_template_form_cpss" model="ir.ui.view">
        <field name="name">product.template.cpss</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="inside">
                <group string="test stock min">
                            <field name="cpss_block_below_min" colspan="2" placeholder="test."/>
                </group>
<!--                <field name="cpss_block_below_min"/>-->
            </xpath>
        </field>
    </record>
</odoo>