<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vue formulaire pour la configuration -->
        <record id="view_sync_config_form" model="ir.ui.view">
            <field name="name">cpss.sync.config.form</field>
            <field name="model">cpss.sync.config</field>
            <field name="arch" type="xml">
                <form string="Configuration Synchronisation Inter-Sociétés">
                    <header>
                        <button name="action_test_synchronisation"
                                type="object"
                                string="Tester la configuration"
                                class="btn-secondary"
                                groups="cpss_sync_inter_company_base.group_sync_admin"/>
                        <button name="action_configurer_donnees_partagees"
                                type="object"
                                string="Configurer les données partagées"
                                class="btn-secondary"
                                confirm="Cette action rend les contacts et produits des deux sociétés partagés (champ Société vidé). L'opération est irréversible : la société d'origine n'est pas conservée. Continuer ?"
                                attrs="{'invisible': ['&amp;', ('nb_contacts_a_partager', '=', 0), ('nb_produits_a_partager', '=', 0)]}"
                                groups="cpss_sync_inter_company_base.group_sync_admin"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>Configuration Synchronisation Inter-Sociétés</h1>
                            <p class="text-muted">Définissez les deux sociétés et le journal cible</p>
                        </div>

                        <group>
                            <group string="Sociétés">
                                <field name="societe_operationnelle_id"
                                       options="{'no_create': True, 'no_open': True}"
                                       required="1"/>
                                <field name="societe_cible_id"
                                       options="{'no_create': True, 'no_open': True}"
                                       required="1"/>
                            </group>
                            <group string="Configuration">
                                <field name="journal_fiscal_defaut_id"
                                       options="{'no_create': True}"
                                       context="{'default_company_id': societe_cible_id}"/>
                            </group>
                        </group>

                        <group string="Données partagées">
                            <group>
                                <field name="nb_contacts_partages"/>
                                <field name="nb_produits_partages"/>
                            </group>
                            <group>
                                <field name="nb_contacts_a_partager"/>
                                <field name="nb_produits_a_partager"/>
                            </group>
                        </group>

                        <div class="alert alert-warning" role="alert"
                             attrs="{'invisible': ['&amp;', ('nb_contacts_a_partager', '=', 0), ('nb_produits_a_partager', '=', 0)]}">
                            Certains contacts ou produits sont rattachés à une seule des deux
                            sociétés : ils ne sont pas visibles depuis l'autre et la
                            synchronisation des documents qui les utilisent échouera.
                        </div>

                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vue liste -->
        <record id="view_sync_config_tree" model="ir.ui.view">
            <field name="name">cpss.sync.config.tree</field>
            <field name="model">cpss.sync.config</field>
            <field name="arch" type="xml">
                <tree string="Sync Configurations" create="false" delete="false">
                    <field name="societe_operationnelle_id"/>
                    <field name="societe_cible_id"/>
                    <field name="journal_fiscal_defaut_id"/>
                </tree>
            </field>
        </record>

        <!-- Ancienne action act_window conservée pour compatibilité DB -->
        <record id="action_sync_config" model="ir.actions.act_window">
            <field name="name">Configuration Synchronisation</field>
            <field name="res_model">cpss.sync.config</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
        </record>

        <!-- Action singleton (server action) pour le menu -->
        <record id="action_sync_config_open" model="ir.actions.server">
            <field name="name">Configuration Synchronisation</field>
            <field name="model_id" ref="model_cpss_sync_config"/>
            <field name="state">code</field>
            <field name="code">action = model.action_open()</field>
        </record>

    </data>
</odoo>
