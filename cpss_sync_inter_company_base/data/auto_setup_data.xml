<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Donner les droits sync admin à l'administrateur -->
        <record id="base.user_admin" model="res.users">
            <field name="groups_id" eval="[(4, ref('cpss_sync_inter_company_base.group_sync_admin'))]"/>
        </record>

    </data>

    <!--
        Le partage des contacts et produits (company_id = False) n'est
        volontairement PAS automatisé ici : il s'agit d'une modification
        irréversible de données de référence. Elle se déclenche manuellement
        via le bouton « Configurer les données partagées » de la
        configuration de synchronisation, et reste limitée aux deux sociétés
        paramétrées.
    -->

</odoo>
