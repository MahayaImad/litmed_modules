<?xml version="1.0"?>
<odoo>

    <template id="report_sale_invoice_document_custom_base" inherit_id="sale.report_saleorder_document">

        <!-- Replace the table with enhanced version -->
        <xpath expr="//table[@class='table table-sm o_main_table table-borderless mt-4']" position="replace">
            <table class="table table-sm o_main_table table-borderless mt-4" style="width: 100%;">
                <thead style="display: table-row-group">
                    <tr>
                        <th name="th_line_number" class="text-center line-number col-1">
                            <span>N°</span>
                        </th>
                        <th name="th_description" class="text-center col-5">
                            <span>Description</span>
                        </th>
                        <th name="th_quantity" class="text-center col-1">
                            <span>Qté</span>
                        </th>
                        <th name="th_priceunit"
                            t-attf-class="col-2 text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span>Prix HT</span>
                        </th>
                        <th name="th_price_unit" t-if="display_discount"
                            t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span>Rem.%</span>
                        </th>
                        <th name="th_taxes"
                            t-attf-class="text-center col-1 {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span>TVA</span>
                        </th>
                        <th name="th_subtotal" class="text-center col-2">
                            <span groups="account.group_show_line_subtotals_tax_excluded">Total HT</span>
                            <span groups="account.group_show_line_subtotals_tax_included">Total TTC</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="sale_tbody">
                    <t t-set="current_subtotal" t-value="0"/>

                    <t t-set="line_number" t-value="0"/>

                    <t t-foreach="lines_to_report" t-as="line">
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"
                           groups="account.group_show_line_subtotals_tax_excluded"/>
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_total"
                           groups="account.group_show_line_subtotals_tax_included"/>

                        <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                            <t t-if="not line.display_type">
                                <t t-set="line_number" t-value="line_number + 1"/>
                                <td name="line_number" class="text-center line-number">
                                    <span t-esc="line_number"/>
                                </td>
                                <td name="td_name">
                                    <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                </td>
                                <td name="td_quantity" class="text-center">
                                    <span t-field="line.product_uom_qty" t-options='{"widget": "float", "precision": 0}'/>
<!--                                    <span t-esc="lot_qty" t-options='{"widget": "float", "precision": 0}'/>-->
                                     <span t-esc="line.product_uom_id.name" groups="uom.group_uom"/>
                                </td>
                                <td name="td_priceunit" t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                    <span class="text-nowrap" t-field="line.price_unit"/>
                                </td>
                                <td t-if="display_discount"
                                    t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                    <span class="text-nowrap" t-field="line.discount"/>
                                </td>
                                <t t-set="taxes" t-value="line.tax_id and ', '.join(line.tax_id.mapped('name')) or '0%'"/>
                                <td name="td_taxes"
                                    t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                                    <span t-out="taxes" id="line_tax_id"/>
                                </td>
                                <td class="text-end o_price_total">
                                    <span class="text-nowrap" t-field="line.price_subtotal"
                                          groups="account.group_show_line_subtotals_tax_excluded"/>
                                    <span class="text-nowrap" t-field="line.price_total"
                                          groups="account.group_show_line_subtotals_tax_included"/>
                                </td>
                            </t>
                            <t t-if="line.display_type == 'line_section'">
                                <td colspan="99">
                                    <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                </td>
                                <t t-set="current_section" t-value="line"/>
                                <t t-set="current_subtotal" t-value="0"/>
                            </t>
                            <t t-if="line.display_type == 'line_note'">
                                <td colspan="99">
                                    <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                </td>
                            </t>
                        </tr>

                        <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                            <tr class="is-subtotal text-end">
                                <td colspan="99">
                                    <strong class="mr16">Subtotal</strong>
                                    <span t-esc="current_subtotal"
                                          t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>
        </xpath>

        <!-- Replace the header and address sections -->
        <xpath expr="//t[@t-set='address']" position="replace">
            <div class="row">
                <div class="col-6">
                    <h3>
                        <span t-if="env.context.get('proforma', False) or is_pro_forma">Facture Proforma </span>
                        <span t-elif="doc.state in ['draft','sent']">Devis </span>
                        <span t-else="">Bon de Commande </span>
                        <span t-field="doc.name"/>
                    </h3>
                    <div id="informations" class="row mt-4 mb-4">
                        <!-- First row - 2 items -->
                        <div class="col-auto col-3 mw-100 mb-2" t-if="doc.date_order" name="date_order">
                            <strong>Date:</strong>
                            <p class="m-0" t-field="doc.date_order"/>
                        </div>
                        <div class="col-auto col-3 mw-100 mb-2"
                             t-if="doc.validity_date and doc.state in ['draft', 'sent']"
                             name="due_date">
                            <strong>Date d'expiration:</strong>
                            <p class="m-0" t-field="doc.validity_date"/>
                        </div>
                    </div>

                </div>
                <!-- Address Section -->
                <div class="col-6"
                     style="width: 50%; border: 1px dotted #333; display: flex; align-items: center; justify-content: center;border-radius: 15px;padding: 20px;">
                    <h5 style="border-bottom: 1px dotted #333; width: 100%; ">Client :
                        <span t-field="doc.partner_id.name"/>
                    </h5>
                    <div class="custom-address">

                        <div class="address-line " t-if="doc.partner_id.street">
                            <span t-field="doc.partner_id.street"/>
                        </div>
                        <div class="address-line" t-if="doc.partner_id.street2">
                            <span t-field="doc.partner_id.street2"/>
                        </div>
                        <div class="address-line" t-if="doc.partner_id.zip">
                            <span t-field="doc.partner_id.zip"/>
                            <span t-field="doc.partner_id.city"/>
                            <span t-if="doc.partner_id.state_id">(<span t-field="doc.partner_id.state_id"/>),
                            </span>
                            <span t-field="doc.partner_id.country_id"/>
                        </div>

                        <div class="contact-info">
                            <div t-if="doc.partner_id.phone">
                                <b>Tél:</b>
                                <span t-field="doc.partner_id.phone"/>
                            </div>
                            <div t-if="doc.partner_id.mobile">
                                <b>Mobile:</b>
                                <span t-field="doc.partner_id.mobile"/>
                            </div>
                            <div t-if="doc.partner_id.fax">
                                <b>Fax:</b>
                                <span t-field="doc.partner_id.fax"/>
                            </div>
                        </div>

                        <div class="legal-info">
                            <t t-if="doc.company_id.activity_code_in_invoice == True">
                                <t t-if="doc.partner_id.company_type == 'company'">
                                    <div t-if="doc.partner_id.activity_code">
                                        <strong>Code d'activité :</strong>
                                        <span t-field="doc.partner_id.activity_code"/>
                                    </div>
                                </t>
                                <t t-else="">
                                    <t t-if="doc.partner_id.parent_id">
                                        <div t-if="doc.partner_id.parent_id.activity_code">
                                            <strong>Code d'activité :</strong>
                                            <span t-field="doc.partner_id.parent_id.activity_code"/>
                                        </div>
                                    </t>
                                </t>
                            </t>

                            <t t-if="doc.company_id.industry_id_in_invoice == True">
                                <t t-if="doc.partner_id.company_type == 'company'">
                                    <div t-if="doc.partner_id.industry_id.name">
                                        <strong>Secteur d'activité :</strong>
                                        <span t-field="doc.partner_id.industry_id.name"/>
                                    </div>
                                </t>
                                <t t-else="">
                                    <t t-if="doc.partner_id.parent_id">
                                        <div t-if="doc.partner_id.parent_id.industry_id.name">
                                            <strong>Secteur d'activité :</strong>
                                            <span t-field="doc.partner_id.parent_id.industry_id.name"/>
                                        </div>
                                    </t>
                                </t>
                            </t>

                            <div>
                                <span t-if="doc.partner_id.rc">
                                    <b>RC N°:</b>
                                    <span t-field="doc.partner_id.rc"/>
                                </span>
                                <span t-if="doc.partner_id.ai">
                                    <b>AI :</b>
                                    <span t-field="doc.partner_id.ai"/>
                                </span>
                            </div>
                            <div>
                                <span t-if="doc.partner_id.nif">
                                    <b>NIF :</b>
                                    <span t-field="doc.partner_id.nif"/>
                                </span>
                                <span t-if="doc.partner_id.nis">
                                    <b>NIS :</b>
                                    <span t-field="doc.partner_id.nis"/>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </xpath>

        <!-- Remove the existing h2 header inside the page div -->
        <xpath expr="//div[@class='page']/h2" position="replace"/>

        <!-- Remove the existing document information section inside the page div -->
        <xpath expr="//div[@class='page']/div[@id='informations']" position="replace"/>
    </template>

    <template id="report_sale_invoice_document_custom_inhirited"
              inherit_id="l10n_dz_invoice.report_sale_invoice_document_custom_base">

        <!-- Placer le cachet -->
        <xpath expr="//p[contains(text(), 'Visa / Signature :') and contains(@style, 'text-decoration:underline')]"
               position="after">
            <div class="mt-2 text-center" t-if="doc.company_id.company_stamp">
                <img t-att-src="image_data_uri(doc.company_id.company_stamp)"
                     style="max-height: 160px; max-width: 160px;" alt="Cachet de la Société"/>
            </div>
        </xpath>
        <!-- Remove Solde actuel -->
        <xpath expr="//strong[contains(text(), 'Solde actuel:')]" position="replace"/>

    </template>

</odoo>
