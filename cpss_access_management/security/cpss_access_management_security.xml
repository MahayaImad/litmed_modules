<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_cpss_access_management" model="ir.module.category">
            <field name="name">Access Management</field>
            <field name="description">Access rights for the Access Management application</field>
            <field name="sequence">27</field>
        </record>

        <!-- Odoo 19: groups are organized by privilege (res.groups.privilege),
             shown as a selection on the user form. -->
        <record id="res_groups_privilege_access_management" model="res.groups.privilege">
            <field name="name">Access Management</field>
            <field name="category_id" ref="module_category_cpss_access_management"/>
            <field name="sequence">27</field>
        </record>

        <record id="group_access_manager" model="res.groups">
            <field name="name">Access Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_access_management"/>
            <field name="sequence">10</field>
            <field name="comment">Configures the access profiles and the per-user restrictions. Members of this group are never restricted themselves, so that the configuration always stays reachable.</field>
        </record>

        <!-- The settings administrator implicitly gets the access manager rights. -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_access_manager'))]"/>
        </record>

        <!-- ================= Record rules ================= -->

        <record id="rule_access_profile_company" model="ir.rule">
            <field name="name">Access Profile: multi-company</field>
            <field name="model_id" ref="model_cpss_access_profile"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="rule_access_menu_rule_company" model="ir.rule">
            <field name="name">Access Rule Menu: multi-company</field>
            <field name="model_id" ref="model_cpss_access_menu_rule"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="rule_access_model_rule_company" model="ir.rule">
            <field name="name">Access Rule Model: multi-company</field>
            <field name="model_id" ref="model_cpss_access_model_rule"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="rule_access_field_rule_company" model="ir.rule">
            <field name="name">Access Rule Field: multi-company</field>
            <field name="model_id" ref="model_cpss_access_field_rule"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="rule_access_button_rule_company" model="ir.rule">
            <field name="name">Access Rule Button: multi-company</field>
            <field name="model_id" ref="model_cpss_access_button_rule"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="rule_access_report_rule_company" model="ir.rule">
            <field name="name">Access Rule Report: multi-company</field>
            <field name="model_id" ref="model_cpss_access_report_rule"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="rule_access_domain_rule_company" model="ir.rule">
            <field name="name">Access Rule Domain: multi-company</field>
            <field name="model_id" ref="model_cpss_access_domain_rule"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

    </data>
</odoo>
