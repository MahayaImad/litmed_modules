<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_cpss_navbar_color" model="ir.ui.view">
        <field name="name">res.company.form.cpss.navbar.color</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <!-- Accroche volontairement large : la disposition interne du
                 formulaire société varie selon les modules installés. -->
            <xpath expr="//sheet" position="inside">
                <group string="Repère visuel">
                    <field name="navbar_color" placeholder="#017E84"/>
                    <div colspan="2" class="text-muted">
                        Couleur de la barre de menu lorsque cette société est active.
                        Elle permet de reconnaître d'un coup d'œil la société dans
                        laquelle on travaille. Laisser vide pour conserver la couleur
                        standard d'Odoo.
                    </div>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
