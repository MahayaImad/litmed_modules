<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_access_management" model="ir.ui.view">
        <field name="name">res.users.form.inherit.access.management</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Access Management" name="access_management"
                      groups="cpss_access_management.group_access_manager">
                    <group>
                        <field name="access_profile_ids" widget="many2many_tags"
                               options="{'no_create_edit': True}"/>
                        <field name="access_hide_chatter"/>
                    </group>
                    <separator string="Menu Restrictions"/>
                    <field name="access_menu_rule_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="menu_id" options="{'no_create': True}"/>
                            <field name="include_children"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                        </tree>
                    </field>
                    <separator string="Model Restrictions"/>
                    <field name="access_model_rule_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="disable_create"/>
                            <field name="disable_edit"/>
                            <field name="disable_delete"/>
                            <field name="disable_duplicate"/>
                            <field name="disable_export"/>
                            <field name="disable_archive"/>
                            <field name="disable_actions"/>
                            <field name="disable_print"/>
                            <field name="hide_chatter"/>
                            <field name="hide_filters"/>
                            <field name="hide_group_by"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                        </tree>
                    </field>
                    <separator string="Field Restrictions"/>
                    <field name="access_field_rule_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="field_id" options="{'no_create': True}"/>
                            <field name="attribute"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                        </tree>
                    </field>
                    <separator string="Button Restrictions"/>
                    <field name="access_button_rule_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="element_type"/>
                            <field name="element_name"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                        </tree>
                    </field>
                    <separator string="Report Restrictions"/>
                    <field name="access_report_rule_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="report_id" options="{'no_create': True}"/>
                            <field name="model_name"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                        </tree>
                    </field>
                    <separator string="Domain Restrictions"/>
                    <field name="access_domain_rule_ids" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_access_users" model="ir.actions.act_window">
        <field name="name">Users</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('share', '=', False)]</field>
    </record>

</odoo>
