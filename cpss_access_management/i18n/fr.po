#. module: cpss_access_management
#: code:addons/cpss_access_management/models/access_field_rule.py:0
msgid ""
"Field %(field)s cannot be required and invisible at the same time: the "
"records could no longer be saved."
msgstr ""
"Le champ %(field)s ne peut pas être obligatoire et invisible en même temps : "
"les enregistrements ne pourraient plus être sauvegardés."

#. module: cpss_access_management
#: code:addons/cpss_access_management/models/access_rule_mixin.py:0
msgid ""
"An access rule must target either an access profile or a user, not both and "
"not neither."
msgstr ""
"Une règle d'accès doit cibler soit un profil d'accès, soit un utilisateur, "
"ni les deux, ni aucun."

#. module: cpss_access_management
#: code:addons/cpss_access_management/models/base_access.py:0
