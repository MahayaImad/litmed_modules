"Your access profile does not allow you to %(operation)s records of type "
"%(model)s."
msgstr ""
"Votre profil d'accès ne vous permet pas d'effectuer l'opération "
"« %(operation)s » sur les enregistrements de type %(model)s."

#. module: cpss_access_management
#: code:addons/cpss_access_management/models/base_access.py:0
msgid ""
"Your access profile does not allow you to modify the following fields of "
"%(model)s: %(fields)s."
msgstr ""
"Votre profil d'accès ne vous permet pas de modifier les champs suivants de "
"%(model)s : %(fields)s."

#. module: cpss_access_management
#: code:addons/cpss_access_management/models/ir_actions.py:0
msgid ""
"Your access profile does not allow you to print the reports of type "
